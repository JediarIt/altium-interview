<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Restore only from nuget.org, regardless of machine-level feeds, so the build is reproducible. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
