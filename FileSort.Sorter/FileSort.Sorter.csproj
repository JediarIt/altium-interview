<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A thin console host over FileSort.Engine: the command line, the console output and the exit codes. It runs on the
    regular .NET runtime; it is not published as a standalone executable.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      Workstation garbage collection with background collection, the runtime's default, kept by measurement (README,
      Performance, "The garbage collector"): the sorter allocates its buffers once and almost nothing after them, its
      peak working set was the same in every mode within 2 MiB, server collection only added a collector thread per
      logical processor, and background collection on or off made no difference that two series agreed on.
    -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileSort.Cli\FileSort.Cli.csproj" />
    <ProjectReference Include="..\FileSort.Engine\FileSort.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FileSort.Tests" />
    <InternalsVisibleTo Include="FileSort.Benchmarks" />
  </ItemGroup>

</Project>