<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!--
      Test names are sentences with underscores (CA1707): they are read in test reports, not called from code.
      Test doubles hold in-memory writers that have nothing to release (CA1001).
    -->
    <NoWarn>$(NoWarn);CA1707;CA1001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileSort.Cli\FileSort.Cli.csproj" />
    <ProjectReference Include="..\FileSort.Common\FileSort.Common.csproj" />
    <ProjectReference Include="..\FileSort.Engine\FileSort.Engine.csproj" />
    <ProjectReference Include="..\FileSort.Generator\FileSort.Generator.csproj" />
    <ProjectReference Include="..\FileSort.Sorter\FileSort.Sorter.csproj" />
    <ProjectReference Include="..\FileSort.Checker\FileSort.Checker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests compare the options table of a program's README with the program's command line. -->
    <None Include="..\FileSort.Generator\README.md" Link="FileSort.Generator.README.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\FileSort.Checker\README.md" Link="FileSort.Checker.README.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\FileSort.Sorter\README.md" Link="FileSort.Sorter.README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
